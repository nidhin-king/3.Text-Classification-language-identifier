# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Test caches
.pytest_cache/

# Model artifacts (large binaries are regenerated by train.py)
models/*.joblib
models/*.joblib.*
models/*.pickle
models/*.pkl
!models/.gitkeep

# Generated datasets (regenerated by data_loader.py)
dataset/*.csv
dataset/*.json
!dataset/.gitkeep
!dataset/sample_predictions.csv

# Reports / generated plots
reports/
data/

# Streamlit / local runtime state
.streamlit/secrets.toml

# Logs
*.log
logs/
nohup.out

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment files
.env
.env.local
